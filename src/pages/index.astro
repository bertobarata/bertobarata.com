---
import Base from '../layouts/Base.astro';
import { profile, roles, projects, techLogos, fundamentos, education, facets } from '../data/site';
import * as si from 'simple-icons';

const year = new Date().getFullYear();

// Resolve each tech to its icon path + a legible fill (near-black brand
// colors are swapped for ink so they read on the dark surface).
type Icon = { path: string; hex: string; title: string };
const luminance = (hex: string) => {
  const n = parseInt(hex, 16);
  const r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
  return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
};
const techs = techLogos.map((t) => {
  const icon = t.slug ? ((si as Record<string, Icon>)[t.slug]) : undefined;
  const fill = icon && luminance(icon.hex) > 0.22 ? `#${icon.hex}` : 'var(--ink)';
  return { name: t.name, path: icon?.path ?? null, fill };
});

// Nav social icons. LinkedIn was removed from simple-icons (trademark), so its
// path is inlined; Barata Studio has no logo, so it uses a "BS" monogram.
const LINKEDIN_PATH =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z';
const navSlug: Record<string, string | null> = {
  GitHub: 'siGithub',
  LinkedIn: '__linkedin',
  'Barata Studio': null,
};
const navLinks = profile.socials
  .filter((s) => s.label in navSlug)
  .map((s) => {
    const slug = navSlug[s.label];
    const path =
      slug === '__linkedin'
        ? LINKEDIN_PATH
        : slug
          ? ((si as Record<string, Icon>)[slug]?.path ?? null)
          : null;
    return { label: s.label, href: s.href, path };
  });
---

<Base>
  <!-- ============ NAV ============ -->
  <header class="nav">
    <div class="wrap nav__inner">
      <a href="#top" class="nav__logo">BB<span>.</span></a>
      <div class="nav__actions">
        {navLinks.map((l) => (
          <a href={l.href} target="_blank" rel="noopener" class="nav__icon" aria-label={l.label} title={l.label}>
            {l.path ? (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.path} /></svg>
            ) : (
              <span class="nav__mono" aria-hidden="true">BS</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </header>

  <main id="top">
    <!-- fixed side navigator: always advances to the next section -->
    <button class="nav-next" type="button" aria-label="Próxima secção" hidden>
      <span class="nav-next__label">Próximo</span>
      <span class="nav-next__arrow">↓</span>
    </button>

    <!-- ============ HERO ============ -->
    <section class="hero wrap">
      <span class="pill reveal"><span class="pill__dot"></span>{profile.available}</span>
      <p class="eyebrow reveal">Olá, o meu nome é</p>
      <div class="hero__title-wrap reveal">
        <h1 class="hero__title" aria-label="Berto Barata">
          <span class="word">
            {'Berto'.split('').map((c, i) => (
              <span class="ltr" style={`--i:${i}`} aria-hidden="true">{c}</span>
            ))}
          </span>
          <span class="word word--hl">
            {'Barata'.split('').map((c, i) => (
              <span class="ltr hl" style={`--i:${i + 5}`} aria-hidden="true">{c}</span>
            ))}
          </span>
        </h1>
      </div>
      <p class="hero__roles reveal">
        <span class="hero__roles-fixed">Sou</span>
        <span class="roleword" data-roles={JSON.stringify(roles)}>{roles[0]}</span>
      </p>
      <p class="hero__intro reveal">{profile.intro}</p>
      <div class="hero__actions reveal">
        <a href="#work" class="btn btn--primary">Ver projetos →</a>
        <a href={`mailto:${profile.email}`} class="btn btn--ghost">Falar comigo</a>
      </div>

    </section>

    <!-- ============ ABOUT / FACETS ============ -->
    <section id="about" class="section">
      <div class="wrap">
        <p class="eyebrow reveal">Sobre</p>
        <div class="about__top">
          <div class="about__intro">
            <h2 class="section-title reveal">Uma pessoa, três frentes, todas com o mesmo cuidado.</h2>
            <p class="about__bio reveal">
              Lisboeta, engenheiro informático em formação e obcecado por detalhe. Gosto de transformar ideias em coisas que funcionam, do primeiro rascunho ao deploy, e de as deixar melhor do que as encontrei.
            </p>
          </div>
          <figure class="about__photo reveal">
            <img src="/images/berto.jpg" alt="Retrato de Berto Barata" width="656" height="842" loading="lazy" decoding="async" />
          </figure>
        </div>
        <div class="facets">
          {facets.map((f) => (
            <article class="facet reveal">
              <span class="facet__kicker">{f.kicker}</span>
              <h3 class="facet__title">{f.title}</h3>
              <p class="facet__body">{f.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ SKILLS ============ -->
    <section id="skills" class="section">
      <div class="wrap">
        <p class="eyebrow reveal">Stack & fundamentos</p>
        <h2 class="section-title reveal">Tecnologias que uso e já usei.</h2>
        <ul class="techgrid reveal">
          {techs.map((t) => (
            <li class="tech" style={`--fill:${t.fill}`}>
              {t.path ? (
                <svg viewBox="0 0 24 24" role="img" aria-label={t.name}>
                  <path d={t.path} />
                </svg>
              ) : (
                <span class="tech__mono" aria-hidden="true">{t.name.slice(0, 2)}</span>
              )}
              <span class="tech__name">{t.name}</span>
            </li>
          ))}
        </ul>
        <p class="fundamentos reveal">
          <span class="fundamentos__label">Fundamentos</span>
          {fundamentos.join(' · ')}
        </p>
        <p class="fundamentos reveal">
          <span class="fundamentos__label">Idiomas</span>
          {profile.languages.map((l) => `${l.name} (${l.level})`).join(' · ')}
        </p>
      </div>
    </section>

    <!-- ============ WORK ============ -->
    <section id="work" class="section">
      <div class="wrap">
        <p class="eyebrow reveal">Projetos selecionados</p>
        <h2 class="section-title reveal">Projetos realizados recentemente.</h2>
        <p class="section-lede reveal">
          Trabalho real, entregue a clientes reais, do briefing ao deploy.
        </p>

        <div class="grid">
          {projects.map((p) => (
            <article class="card reveal" style="--card-accent:var(--accent)">
              <div class="card__thumb">
                <img src={p.image} alt={`Website ${p.name}`} loading="lazy" decoding="async" width="1200" height="750" />
                <span class={`tag tag--${p.status}`}>
                  {p.status === 'live' ? '● live' : '◐ em curso'}
                </span>
              </div>
              <div class="card__body">
                <span class="card__cat">{p.category}</span>
                <h3 class="card__title">{p.name}</h3>
                <p class="card__desc">{p.description}</p>
                <ul class="card__stack">
                  {p.stack.map((s) => <li>{s}</li>)}
                </ul>
                <div class="card__links">
                  {p.href && (
                    <a href={p.href} target="_blank" rel="noopener" class="card__link">
                      Visitar site ↗
                    </a>
                  )}
                  {p.repo && (
                    <a href={p.repo} target="_blank" rel="noopener" class="card__link card__link--muted">
                      Código
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ EDUCATION ============ -->
    <section id="education" class="section">
      <div class="wrap">
        <p class="eyebrow reveal">Formação</p>
        <h2 class="section-title reveal">A caminho de engenheiro informático.</h2>
        {education.map((e) => (
          <article class="edu reveal">
            <div class="edu__head">
              <h3 class="edu__title">{e.title}</h3>
              <span class="edu__period">{e.period}</span>
            </div>
            <p class="edu__org">{e.org}</p>
            <p class="edu__note">{e.note}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ============ CONTACT ============ -->
    <section id="contact" class="section contact">
      <div class="wrap">
        <p class="eyebrow reveal">Contacto</p>
        <h2 class="contact__title reveal">Aberto a novas<br />oportunidades.</h2>
        <p class="contact__lede reveal">
          À procura de alguém que constrói com cuidado e entrega até ao fim? Vamos falar.
        </p>
        <div class="contact__btns reveal">
          <a href={`mailto:${profile.email}`} class="btn btn--primary contact__btn">
            {profile.email} →
          </a>
        </div>
        <div class="contact__socials reveal">
          {profile.socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="social">
              <span class="social__label">{s.label}</span>
              <span class="social__handle">{s.handle}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="wrap footer__inner">
        <span>© {year} {profile.name}</span>
        <span class="footer__made">Feito à mão com Astro · {profile.location}</span>
      </div>
    </footer>
  </main>

  <script>
    // Rotating hero roles
    const el = document.querySelector<HTMLElement>('.roleword');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (el && !reduce) {
      let list: string[] = [];
      try { list = JSON.parse(el.dataset.roles || '[]'); } catch {}
      if (list.length > 1) {
        let i = 0;
        setInterval(() => {
          el.classList.add('swap');
          setTimeout(() => {
            i = (i + 1) % list.length;
            el.textContent = list[i];
            el.classList.remove('swap');
          }, 320);
        }, 2600);
      }
    }

    // Hero name follows the cursor anywhere on screen by tilting in 3D (desktop, motion-safe)
    const title = document.querySelector<HTMLElement>('.hero__title');
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (title && fine && !reduce) {
      let raf = 0, mx = window.innerWidth / 2, my = window.innerHeight / 2;
      const clamp = (v: number) => Math.max(-0.5, Math.min(0.5, v));
      const paint = () => {
        raf = 0;
        const r = title.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        // position of cursor relative to the name's center, normalised by viewport
        const px = clamp((mx - cx) / window.innerWidth);
        const py = clamp((my - cy) / window.innerHeight);
        title.style.transform =
          `rotateY(${px * 26}deg) rotateX(${-py * 20}deg) translateZ(0)`;
      };
      window.addEventListener('pointermove', (ev) => {
        mx = ev.clientX; my = ev.clientY;
        if (!raf) raf = requestAnimationFrame(paint);
      }, { passive: true });
    }

    // Fixed side navigator: click to advance one section (or back to top at the end)
    const navBtn = document.querySelector<HTMLButtonElement>('.nav-next');
    const arrow = navBtn?.querySelector<HTMLElement>('.nav-next__arrow');
    const label = navBtn?.querySelector<HTMLElement>('.nav-next__label');
    const sections = [
      document.querySelector<HTMLElement>('.hero'),
      ...['about', 'skills', 'work', 'education', 'contact'].map((id) => document.getElementById(id)),
    ].filter((el): el is HTMLElement => !!el);

    if (navBtn && sections.length) {
      navBtn.hidden = false;
      const nextSection = () =>
        sections.find((s) => s.getBoundingClientRect().top > window.innerHeight * 0.5) ?? null;
      const sync = () => {
        const atEnd = !nextSection();
        navBtn.classList.toggle('nav-next--top', atEnd);
        if (arrow) arrow.textContent = atEnd ? '↑' : '↓';
        if (label) label.textContent = atEnd ? 'Início' : 'Próximo';
        navBtn.setAttribute('aria-label', atEnd ? 'Voltar ao início' : 'Próxima secção');
      };
      const NAV_H = 64;
      navBtn.addEventListener('click', () => {
        const next = nextSection();
        const target = next ?? sections[0];
        const top = window.scrollY + target.getBoundingClientRect().top - (next ? NAV_H : 0);
        window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      });
      window.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
      sync();
    }
  </script>
</Base>

<style>
  /* ---------- NAV ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line-soft);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .nav__logo {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.04em;
  }
  .nav__logo span { color: var(--accent); }
  .nav__actions {
    display: flex;
    gap: 0.55rem;
  }
  .nav__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink-muted);
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .nav__icon svg { width: 18px; height: 18px; fill: currentColor; }
  .nav__mono {
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: -0.03em;
  }
  .nav__icon:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
    background: var(--bg-elev);
    transform: translateY(-2px);
  }

  /* ---------- HERO ---------- */
  .pill {
    display: flex;
    align-items: center;
    gap: 0.55em;
    width: fit-content;
    margin: 0 auto 1.5rem;
    padding: 0.45em 0.95em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-card);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .pill__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    animation: pulse 2.2s ease-out infinite;
  }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5); }
    70%  { box-shadow: 0 0 0 7px rgba(74, 222, 128, 0); }
    100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .pill__dot { animation: none; } }

  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    scroll-snap-align: start;
    padding-top: clamp(5rem, 10vw, 7rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
    text-align: center;
  }
  .hero__title-wrap { perspective: 900px; }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 14vw, 9rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 0.94;
    text-transform: uppercase;
    transform-style: preserve-3d;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  .word { display: inline-block; }
  .word--hl { margin-left: 0.3em; }
  .hero__title .ltr { display: inline-block; }
  .hero__title .hl {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
    text-stroke: 1.5px var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__title { transition: none; }
  }
  .hero__roles {
    margin-top: 1.8rem;
    font-size: clamp(1.3rem, 3.6vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.4em;
    flex-wrap: wrap;
  }
  .hero__roles-fixed { color: var(--ink-muted); }
  .roleword {
    color: var(--accent);
    position: relative;
    transition: opacity 0.32s ease, transform 0.32s ease;
  }
  .roleword.swap { opacity: 0; transform: translateY(-6px); }
  .roleword::after {
    content: '';
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    background: var(--accent);
    transform: translateY(2px);
    animation: caret 1s steps(1) infinite;
  }
  @keyframes caret { 50% { opacity: 0; } }

  .hero__intro {
    margin: 1.6rem auto 0;
    color: var(--ink-muted);
    max-width: 56ch;
    font-size: 1.05rem;
  }
  .hero__actions {
    margin-top: 2.4rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
  }
  .nav-next {
    position: fixed;
    right: clamp(0.9rem, 2.5vw, 2rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem 0.7rem;
    border: 1px solid var(--accent-dim);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-card) 82%, transparent);
    backdrop-filter: blur(10px);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 6px 24px -10px rgba(0, 0, 0, 0.6);
    transition: color 0.2s, background 0.2s, border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .nav-next__label { font-size: 0.62rem; }
  .nav-next__arrow {
    display: inline-block;
    font-size: 1rem;
    animation: bob 1.8s ease-in-out infinite;
  }
  .nav-next:hover {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
    transform: translateY(-50%) scale(1.06);
    box-shadow: 0 8px 30px -8px rgba(216, 255, 94, 0.5);
  }
  .nav-next:hover .nav-next__arrow { animation: none; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
  @media (max-width: 600px) {
    .nav-next { right: 0.7rem; padding: 0.8rem 0.55rem; font-size: 0.62rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .roleword::after, .nav-next__arrow { animation: none; }
    .nav-next { transition: none; }
  }

  /* ---------- ABOUT ---------- */
  .about__top {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  /* text on the left, flush right toward the photo */
  .about__intro { text-align: right; }
  .about__intro .section-title {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }
  .about__photo {
    margin: 0;
    position: relative;
    max-width: 340px;
  }
  @media (max-width: 720px) {
    .about__top { grid-template-columns: 1fr; }
    .about__intro { text-align: center; }
    .about__intro .section-title { margin-inline: auto; text-align: center; }
    .about__photo { max-width: 300px; margin-inline: auto; order: -1; }
  }
  .about__photo img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    /* fade the edges so the dark portrait melts into the page */
    -webkit-mask-image: radial-gradient(120% 100% at 50% 42%, #000 52%, transparent 92%);
    mask-image: radial-gradient(120% 100% at 50% 42%, #000 52%, transparent 92%);
    filter: saturate(0.92) contrast(1.02);
    transition: filter 0.4s ease;
  }
  .about__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    box-shadow: inset 0 0 60px 20px rgba(216, 255, 94, 0);
    transition: box-shadow 0.4s ease;
    pointer-events: none;
  }
  .about__photo:hover img { filter: saturate(1.05) contrast(1.04); }
  .about__photo:hover::after { box-shadow: inset 0 0 70px 10px rgba(216, 255, 94, 0.12); }
  .about__bio {
    margin: 1.4rem 0 0 auto;
    color: var(--ink-muted);
    font-size: 1.08rem;
    max-width: 52ch;
  }
  @media (max-width: 720px) {
    .about__bio { margin-inline: auto; }
  }

  /* ---------- FACETS ---------- */
  .facets {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .facet {
    padding: 1.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
    text-align: left;
    transition: border-color 0.2s, transform 0.2s;
  }
  .facet:hover { border-color: var(--ink-faint); transform: translateY(-3px); }
  .facet__kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent-dim);
  }
  .facet__title { margin-top: 0.7rem; font-size: 1.55rem; font-family: var(--font-head); font-weight: 400; letter-spacing: 0; }
  .facet__body { margin-top: 0.7rem; color: var(--ink-muted); font-size: 0.96rem; }

  /* ---------- WORK GRID ---------- */
  .grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.1rem;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
    overflow: hidden;
    transition: border-color 0.25s, transform 0.25s;
  }
  .card:hover {
