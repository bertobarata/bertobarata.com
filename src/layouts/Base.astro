---
import '../styles/global.css';
import { profile, content, homePath, langs, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}
const { lang } = Astro.props;
const c = content[lang];
const {
  title = `${profile.name} · ${c.role}`,
  description = c.description,
} = Astro.props;
const site = Astro.site!;
const canonical = new URL(homePath[lang], site).href;
const ogImage = new URL('/og.jpg', site).href;
const locale = { pt: 'pt_PT', en: 'en_GB' } as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://bertobarata.com/#berto',
      name: profile.name,
      url: canonical,
      image: new URL('/images/berto.webp', site).href,
      jobTitle: c.role,
      email: `mailto:${profile.email}`,
      address: { '@type': 'PostalAddress', addressLocality: 'Lisboa', addressCountry: 'PT' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'ISEL, Instituto Superior de Engenharia de Lisboa' },
      worksFor: { '@type': 'Organization', name: 'Barata Studio', url: 'https://baratastudio.com' },
      knowsLanguage: ['pt', 'en', 'fr'],
      sameAs: profile.socials.map((s) => s.href),
    },
    {
      '@type': 'WebSite',
      '@id': 'https://bertobarata.com/#website',
      url: 'https://bertobarata.com/',
      name: profile.name,
      inLanguage: lang === 'pt' ? 'pt-PT' : 'en',
      publisher: { '@id': 'https://bertobarata.com/#berto' },
    },
  ],
};
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-PT' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(homePath[l], site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(homePath.pt, site).href} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={locale[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} · ${c.role}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0c0d0f" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fonts (self-hosted; the display face is part of the LCP) -->
    <link rel="preload" href="/fonts/Array-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Geist-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#about" class="skip-link">{c.ui.skip}</a>
    <slot />

    <script>
      // Scroll-reveal via IntersectionObserver (below the fold only; the hero animates in CSS)
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
